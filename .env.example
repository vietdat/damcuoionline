# Đi Đám Cưới Online 3D - Environment Variables

# Frontend WebSocket Server URL
# In local development, leave empty to proxy through Vite /socket.io
# In production with separate Vercel frontend and Railway backend:
# VITE_SOCKET_URL=https://your-backend-domain.up.railway.app
VITE_SOCKET_URL=

# Backend Port (Defaults to 3001 if omitted, Railway sets PORT automatically)
PORT=3001
